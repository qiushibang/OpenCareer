[Unit]
Description=Publish read-only OpenCareer public job catalog snapshots
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/opencareer-public-feed
Environment=DOCKER_CONFIG=/opt/opencareer-public-feed/docker-config
Environment=DOCKER_HOST=unix:///var/run/docker.sock
ExecStart=/bin/bash /opt/opencareer-public-feed/run-export.sh
Nice=15
IOSchedulingClass=idle
CPUQuota=30%
MemoryMax=192M
TasksMax=32
TimeoutStartSec=300
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/opencareer-public-feed /opt/opencareer/deploy/web/public/jobs/v1
