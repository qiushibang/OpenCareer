# 复制为 deploy/.env 后填写。此文件包含的空值都可能是密钥，真实 .env 不要提交或截图。

# 域名与当前阿里云服务器
BASE_DOMAIN=opencareer.online
SERVER_IP=203.0.113.10
IP_PORT=18080

# 当前 IP 自测入口继续使用的随机 Token：openssl rand -hex 32
TOKEN_A=

# PostgreSQL（关系型数据库）
POSTGRES_DB=opencareer
POSTGRES_USER=opencareer
POSTGRES_PASSWORD=
# 正式域名服务器复用宿主机 PostgreSQL；真实连接串只能保存在服务器 .env。
DATABASE_URL=postgresql://opencareer:请填写数据库密码@127.0.0.1:5432/opencareer_prod
REDIS_URL=redis://127.0.0.1:6379/0
BACKEND_BIND_HOST=172.18.0.1
BACKEND_PORT=18768

# Authing OpenID Connect（OIDC，开放身份连接）
# 回调地址固定为：https://app.opencareer.online/_openworker/auth/callback
OPENCAR_AUTH_ISSUER=https://YOUR_AUTHING_DOMAIN.authing.cn/oidc
OPENCAR_AUTH_CLIENT_ID=
OPENCAR_AUTH_CLIENT_SECRET=
# 生成方法：openssl rand -hex 32
OPENCAR_AUTH_STATE_SECRET=
OPENCAR_AUTH_SESSION_TTL_SECONDS=604800

# 备案通过后填写备案号，再重新构建前端；审批中保持为空。
# 构建示例：VITE_ICP_NUMBER="京ICP备XXXXXXXX号" bash deploy/build-frontend.sh
VITE_ICP_NUMBER=

# 模型
OPENCAR_MODEL=deepseek:deepseek-chat
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENCAR_SEED_DEMO=1

# 每日岗位抓取（默认 profile 不启动）
TZ=Asia/Shanghai
CRAWL_AT=04:00
CRAWL_JITTER_MINUTES=25
CRAWL_RUN_ON_START=0
CRAWL_ONLY=
CRAWL_SKIP=
CRAWL_SOURCE_TIMEOUT=300
CRAWL_PAUSE_SECONDS=3

# 中国内地构建加速
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
REQUIREMENTS=deploy/requirements-server.cn.txt
PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
